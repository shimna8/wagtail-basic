# Staging Environment Variables
# Copy this file to .env and update the values

# Django settings module
DJANGO_SETTINGS_MODULE=voyah.settings.stage

# Security
DEBUG=False
SECRET_KEY=your-staging-secret-key-here-change-this
ALLOWED_HOSTS=stage.example.com,staging.example.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=voyah_stage
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=noreply@example.com

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379/1

# Wagtail
WAGTAILADMIN_BASE_URL=https://stage.example.com

# Security (optional - can be False for staging)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Sentry (optional)
SENTRY_DSN=

